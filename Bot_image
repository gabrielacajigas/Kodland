import discord, random, os, requests
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='$', intents=intents)

@bot.command()
async def gatito(ctx):
    img_name = random.choice(os.listdir('imagen'))
    with open(f'imagen/{img_name}', 'rb') as f:
        # ¡Vamos a almacenar el archivo de la biblioteca Discord convertido en esta variable!
        picture = discord.File(f)
    # A continuación, podemos enviar este archivo como parámetro.
    await ctx.send(file=picture)



def get_cat_image_url():    
    url = 'https://api.thecatapi.com/v1/images/search'
    res = requests.get(url)
    print(res.status_code)
    print(res.text)
    data = res.json()
    return data[0]['url']

@bot.command('cat')
async def cat(ctx):
    '''Una vez que llamamos al comando cat,
    el programa llama a la función get_cat_image_url'''
    image_url = get_cat_image_url()
    await ctx.send(image_url)


bot.run("token")
